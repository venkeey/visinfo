# Environment Variables Configuration

# =============================================================================
# DATABASE
# =============================================================================
MONGODB_URI=mongodb://localhost:27017/visinfo

# =============================================================================
# AUTHENTICATION
# =============================================================================
JWT_SECRET=your_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d

# =============================================================================
# AI EMBEDDING PROVIDERS (Multi-provider with fallback)
# =============================================================================

# Primary Provider: OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_EMBEDDING_MODEL=text-embedding-ada-002
# Get API key from: https://openrouter.ai/keys

# Backup Provider: Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=embedding-001
# Get API key from: https://ai.google.dev/

# Tertiary Provider: OpenAI (Optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
ENABLE_OPENAI=false
# Get API key from: https://platform.openai.com/api-keys

# Offline Fallback: Local Transformers (Optional)
ENABLE_LOCAL_EMBEDDINGS=false
LOCAL_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# Embedding Configuration
SIMILARITY_THRESHOLD=0.75
MAX_EMBEDDING_RETRIES=2
EMBEDDING_RETRY_DELAY=1000

# =============================================================================
# SERVER
# =============================================================================
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# =============================================================================
# CORS
# =============================================================================
CORS_ORIGIN=http://localhost:8080,http://localhost:3000

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=info
