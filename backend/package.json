{
  "name": "visinfo-clustering-server",
  "version": "1.0.0",
  "description": "Poll backend that groups free-text responses with embeddings and hierarchical clustering",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "test": "jest"
  },
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "bull": "^4.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "ml-distance-matrix": "^2.0.1",
    "ml-hclust": "^3.1.0",
    "ml-kmeans": "^6.0.0",
    "mongoose": "^8.0.0",
    "pg": "^8.11.3",
    "socket.io": "^4.6.1",
    "string-similarity": "^4.0.4",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.5",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/src"],
    "testMatch": ["**/__tests__/**/*.test.ts"],
    "transformIgnorePatterns": ["node_modules/(?!(ml-hclust|ml-distance-matrix|ml-distance-euclidean|ml-array-mean|ml-kmeans)/)"]
  }
}
